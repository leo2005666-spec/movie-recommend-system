# 复制本文件为 .env 后填写（勿提交 .env 到 Git）
# TMDB：https://www.themoviedb.org/settings/api

# 必填：TMDB 电影同步
TMDB_API_KEY=

# 可选：OMDb（http://www.omdbapi.com/）— 影片奖项/提名摘要（ Awards 字段），用于详情页「奖项」条与奖项页文案
# OMDB_API_KEY=

# ---------- 定时爬虫 npm run crawler:cron 专用 ----------
# Cron 表达式（默认每 30 分钟跑一次「快速增量」）
# 示例：*/15 * * * * 每 15 分钟；0 */6 * * * 每 6 小时；0 3 * * * 每天凌晨 3 点
TMDB_CRAWLER_CRON=*/30 * * * *

# 可选：时区（node-cron），例如 Asia/Shanghai
# TMDB_CRAWLER_TZ=Asia/Shanghai

# 可选：全量时每源页数 1～50（默认 13）；定时「快速」模式固定每源 1 页，此项仅影响 crawler / crawler:cron:full
# TMDB_CRAWLER_PAGES=13

# 可选：请求间隔毫秒（勿低于约 150，避免 TMDB 限流）
# TMDB_CRAWLER_DELAY_MS=220

# ---------- 若使用 Turso 云数据库，爬虫会写入线上库 ----------
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
